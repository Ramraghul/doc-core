{
  "version": 2,
  "functions": {
    "api/index.js": {
      "includeFiles": ["public/**", "src/docs/openapi.yaml"],
      "maxDuration": 30
    }
  },
  "rewrites": [{ "source": "/(.*)", "destination": "/api/index" }],
  "crons": [{ "path": "/api/v1/internal/purge-trash", "schedule": "0 3 * * *" }]
}
