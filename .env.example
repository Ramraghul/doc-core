# ---- Required in production ----
# MongoDB connection string (Atlas free M0: mongodb+srv://user:pass@cluster.mongodb.net/docucore)
MONGODB_URI=mongodb://127.0.0.1:27017/docucore
# Long random string (>= 32 chars). Generate: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=change-me-to-a-long-random-string-at-least-32-chars

# ---- Optional ----
NODE_ENV=development
PORT=3000
JWT_EXPIRES_IN=8h
BCRYPT_ROUNDS=12

# Max upload size (MB) and per-user storage quota (MB). Atlas M0 has 512MB total, so keep quota small on a public demo.
MAX_FILE_SIZE_MB=10
USER_QUOTA_MB=50
MAX_VERSIONS_PER_DOCUMENT=20

# Days a document stays in the trash before it is purged automatically
TRASH_RETENTION_DAYS=30

# Comma-separated list of allowed browser origins for CORS. Empty = same-origin only.
CORS_ORIGINS=

# Idempotently create/promote an admin account on startup (leave empty to skip)
ADMIN_EMAIL=
ADMIN_PASSWORD=
# Create a demo account on startup so portfolio visitors can try the app (leave empty to skip)
DEMO_EMAIL=
DEMO_PASSWORD=

LOG_LEVEL=info

# Only needed if deploying to Vercel (see docs/DEPLOYMENT.md#vercel): shared secret for the
# unauthenticated GET /api/v1/internal/purge-trash endpoint, which stands in for the in-process cron
# timer that only works on a long-running server (Render/Docker/local). Leave empty elsewhere — the
# endpoint refuses every request with 503 until this is set. Generate the same way as JWT_SECRET.
CRON_SECRET=
